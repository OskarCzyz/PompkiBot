# Token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# The group chat's numeric id (negative number, e.g. -1001234567890).
# Easiest way to get it: add the bot to the group, send any message, then
# check https://api.telegram.org/bot<token>/getUpdates
GROUP_CHAT_ID=-1001234567890

# Comma-separated Telegram user ids allowed to use admin commands
# (/addparticipant, /removeparticipant, /markpaid, /markdone, /markmissed).
# Find your own id by messaging @userinfobot on Telegram.
ADMIN_IDS=123456789

# Last calendar day that still requires pushups (YYYY-MM-DD).
# The final poll opens this morning at 8:00 and closes 24h later,
# at which point the final summary and stats are posted.
LAST_CHALLENGE_DAY=2026-10-09

# Participant who gets a dedicated chart in the final stats
# (@username, numeric id, or first name).
SPOTLIGHT_USER=

# Where to keep the SQLite database file.
DB_PATH=pushups.db

# --- Automatic payments (optional; see "Automatic payments" in the README) ---
# Without these the bot is a plain ledger and /markpaid is the only way to
# mark a day paid.
EB_APP_ID=
EB_KEY_PATH=enablebanking.pem
EB_SESSION_ID=
EB_ACCOUNT_UID=
# Consent expiry (YYYY-MM-DD) — the bot warns the admins a week before.
EB_CONSENT_UNTIL=
EB_ASPSP_NAME=PKO Bank Polski
EB_REDIRECT_URL=https://localhost/
# Shown to participants, e.g. "BLIK na telefon 500 100 200".
PAY_TO=
# Set to 0 to disable kicking people who haven't paid for KICK_AFTER_DAYS (14).
AUTO_KICK=1
